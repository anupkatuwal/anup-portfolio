# Copy to .env for local dev. Set the same vars in Vercel for production.
DATABASE_URL=''         # Neon POOLED connection string (host contains "-pooler")
SECRET_KEY=''           # python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_USERNAME=''
ADMIN_PASSWORD_HASH=''  # bcrypt hash of the admin password
RESEND_API_KEY=''       # from resend.com — enables email notifications on contact form submit
CONTACT_NOTIFY_TO=''    # optional — recipient(s), comma-separated (default: katuwalanup@gmail.com)
CONTACT_NOTIFY_FROM=''  # optional — override sender; needs a Resend-verified domain (default: onboarding@resend.dev)
